APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8788,https://glossy-prototype.vercel.app

# Supabase Postgres connection string.
# Prefer the direct connection string for a long-running API server.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_MODE=require
DB_MIN_POOL_SIZE=1
DB_MAX_POOL_SIZE=5
DB_STATEMENT_CACHE_SIZE=0

# OpenAI API
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini
MAX_INPUT_CHARS=3000
MAX_DOCUMENT_CHARS=10000
MAX_IMAGE_BYTES=4194304
MAX_TERM_SUGGESTIONS=8
